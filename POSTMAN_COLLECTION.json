{
  "info": {
    "_postman_id": "3c9f3e91-8e2a-4c2e-8a5e-6a7b2a1b9a10",
    "name": "Payment Processing Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Sample requests for Authentication, Payments, and Webhooks"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Purchase",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/purchase",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "purchase"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 4999,\n  \"currency\": \"USD\",\n  \"paymentMethod\": {\n    \"cardNumber\": \"4111111111111111\",\n    \"expirationDate\": \"12-2028\",\n    \"cardCode\": \"123\"\n  },\n  \"metadata\": {\"orderId\": \"ord_123\"}\n}"
            }
          },
          "response": []
        },
        {
          "name": "Authorize",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/authorize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "authorize"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 4999,\n  \"currency\": \"USD\",\n  \"paymentMethod\": {\n    \"cardNumber\": \"4111111111111111\",\n    \"expirationDate\": \"12-2028\",\n    \"cardCode\": \"123\"\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "Capture",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/capture",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "capture"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"txn_123\",\n  \"amount\": 4999\n}"
            }
          },
          "response": []
        },
        {
          "name": "Void",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/void",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "void"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"txn_123\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Refund",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/refund",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "refund"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"txn_123\",\n  \"amount\": 1000,\n  \"paymentMethod\": { \"last4\": \"1111\" }\n}"
            }
          },
          "response": []
        },
        {
          "name": "Get Transaction",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "transactions", "{{transactionId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Authorize.Net Webhook (Sample)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-anet-event-type", "value": "net.authorize.payment.capture.created" },
              { "key": "x-anet-signature", "value": "{{anetSignatureHex}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/authorizenet",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "authorizenet"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_abc\",\n  \"type\": \"net.authorize.payment.capture.created\",\n  \"payload\": {\n    \"id\": \"py_123\",\n    \"amount\": 4999,\n    \"status\": \"succeeded\"\n  }\n}"
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "idempotencyKey", "value": "5bb6c1f8-2d3a-4d61-9c8f-02b7e2f9a001" },
    { "key": "transactionId", "value": "txn_123" },
    { "key": "anetSignatureHex", "value": "deadbeef" }
  ]
}
