{
  "name": "payment-processing-service",
  "version": "1.0.0",
  "description": "Payment Processing Service with Node.js and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec node -r tsconfig-paths/register -r ts-node/register src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "start:migrate": "knex migrate:latest && knex seed:run && node dist/server.js",
    "start:worker": "node dist/workers/processWebhooks.js",
    "test": "jest --config=jest.config.js --detectOpenHandles --forceExit",
    "test:ci": "jest --config=jest.config.js --coverage",
    "test:watch": "jest --config=jest.config.js --watch",
    "test:coverage": "jest --config=jest.config.js --coverage",
    "lint": "echo 'Lint disabled' && exit 0",
    "lint:fix": "echo 'Lint fix disabled' && exit 0",
    "format": "echo 'Format disabled' && exit 0",
    "migrate:make": "knex migrate:make",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate": "knex migrate:latest && knex seed:run",
    "seed": "knex seed:run",
    "seed:make": "knex seed:make",
    "seed:run": "knex seed:run",
    "compose": "bash ./scripts/compose.sh",
    "compose:up": "bash ./scripts/compose.sh up --build",
    "compose:down": "bash ./scripts/compose.sh down -v"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "payment",
    "knex"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express-validator": "^2.20.33",
    "@types/helmet": "^0.0.48",
    "authorizenet": "^1.0.6",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.1",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "pino": "^8.21.0",
    "pino-http": "^10.5.0",
    "prom-client": "^14.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.13",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-extended": "^6.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.1.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
