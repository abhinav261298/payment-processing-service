# ===================================
# Server Configuration
# ===================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ===================================
# Database Configuration
# ===================================
# Main database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_processing
# Test database (for running tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_processing_test
# Set to 'true' in production with SSL
DATABASE_SSL=false
# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===================================
# JWT Authentication
# ===================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ===================================
# Authorize.Net Configuration
# ===================================
AUTHORIZE_NET_API_LOGIN_ID=your_login_id
AUTHORIZE_NET_TRANSACTION_KEY=your_transaction_key
# Use 'sandbox' for testing, 'production' for live
AUTHORIZE_NET_ENVIRONMENT=sandbox

# ===================================
# Rate Limiting
# ===================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100  # Max requests per window per IP

# ===================================
# CORS Configuration
# ===================================
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_CREDENTIALS=true

# ===================================
# Security Headers
# ===================================
# Set to 'true' in production
SECURE_HTTPS=false
# Enable HSTS (in production)
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000  # 1 year
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# ===================================
# Logging
# ===================================
# Log format: 'json' for production, 'dev' for development
LOG_FORMAT=dev
# Log file path (leave empty for console only)
LOG_FILE=
# Maximum log file size in bytes (default: 10MB)
LOG_MAX_SIZE=10485760
# Maximum number of log files to keep
LOG_MAX_FILES=5

# ===================================
# API Documentation
# ===================================
# Enable/disable API documentation
ENABLE_API_DOCS=true
# API documentation path
API_DOCS_PATH=/api-docs

# ===================================
# Application Settings
# ===================================
# Application name
APP_NAME=Payment Processing Service
# Application version
APP_VERSION=1.0.0
# Default timezone
TZ=UTC
# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=30000

# ===================================
# Idempotency
# ===================================
# Idempotency key expiration in seconds (default: 24 hours)
IDEMPOTENCY_KEY_TTL=86400

# ===================================
# Webhooks
# ===================================
# Webhook URL for payment events
WEBHOOK_URL=
# Webhook secret for verifying webhook signatures
WEBHOOK_SECRET=

# ===================================
# Email Configuration (for notifications)
# ===================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false  # true for 465, false for other ports
SMTP_USER=username
SMTP_PASS=password
EMAIL_FROM=noreply@example.com
EMAIL_NAME="Payment Service"

# ===================================
# Feature Flags
# ===================================
# Enable/disable maintenance mode
MAINTENANCE_MODE=false
# Enable/disable new user registration
ALLOW_REGISTRATION=true
# Enable/disable email verification
REQUIRE_EMAIL_VERIFICATION=false
# Redis url
REDIS_URL=redis://localhost:6379
ENABLE_WEBHOOK_WORKER=true
